# Web3 Radar on Docker Compose.
#   cp .env.example .env   (then fill in what you use)
# Every value is optional: the stack starts with this file unchanged.
# First-time setup: run ./deploy/srv2-deploy.sh, or prepare a writable ./data directory first:
#   mkdir -p data && RADAR_UID="$(id -u)" RADAR_GID="$(id -g)" docker compose up -d

# ---------------------------------------------------------------------------
# web3-radar
# ---------------------------------------------------------------------------

# Host port that forwards to the dashboard on 127.0.0.1 (the container always
# listens on 3000). Also the port of a bare `bun server/index.ts`.
PORT=3000

# Telegram channels polled per 2-minute tick (0 turns Telegram polling off).
TG_BATCH_SIZE=8
# X accounts polled per 5-minute tick (0 turns X polling off).
X_BATCH_SIZE=3
# RSS / Substack / Galxe feeds polled per 5-minute tick (0 turns them off).
FEED_BATCH_SIZE=3

# Cluster summaries (AI queue on the 2-minute tick). Configure one of the two, or
# leave everything empty to keep rule-based summaries only.
# 1. Any OpenAI-compatible /chat/completions endpoint; both values are required.
#    Example: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=z-ai/glm-4.6
LLM_BASE_URL=
LLM_API_KEY=
#    Optional model override (empty = the Worker's built-in default).
LLM_MODEL=
# 2. Cloudflare Workers AI over REST: account id + API token.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Summaries per day, and clusters summarized per 2-minute tick.
AI_DAILY_MAX=300
AI_SUMMARY_CHUNK=6

# ---------------------------------------------------------------------------
# cloudflared
# ---------------------------------------------------------------------------

# Tunnel token from Cloudflare Zero Trust (Networks > Tunnels > your tunnel).
# Empty: the tunnel container restarts until a token is set.
# In the tunnel's public hostname settings point the service at http://web3-radar:3000
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# rsshub (X timelines for the X_BATCH_SIZE accounts above)
# ---------------------------------------------------------------------------

# The `auth_token` cookie value of a logged-in X session.
TWITTER_AUTH_TOKEN=
# Cookie login instead of the token (optional): needs TWITTER_PASSWORD plus
# TWITTER_USERNAME or TWITTER_PHONE_OR_EMAIL.
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_PHONE_OR_EMAIL=
# Secret used to encrypt the X cookies (any long random string).
TWITTER_AUTHENTICATION_SECRET=
